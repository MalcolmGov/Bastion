# ============================================================
# Gold Fields Flagship & CMS — Environment Configuration
# ============================================================

# Public Application URL (used in canonical links and notification reviews)
NEXT_PUBLIC_APP_URL=http://localhost:3010

# Database Configuration (LibSQL / Turso)
# In local development or standalone VPS, defaults to file:studio.db.
# For Vercel / serverless production persistence across Lambdas:
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Vercel Blob Storage (Media Assets)
# Automatically configured when enabling "Storage -> Blob" in Vercel project dashboard.
# If omitted, uploads save to public/assets locally.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Headless content API, GraphQL, and MCP bearer token.
# Required in every environment. At least 16 characters. Do not reuse a sample value.
# API_SECRET_TOKEN=

# Draft preview links for people who are not logged into the studio (/api/preview?secret=...).
# Logged-in editors can preview without this. At least 16 characters.
# It opens drafts of the root site only (the flagship client's), for 12 hours per browser, and it also signs those
# passes: change or remove it and every pass already issued stops working. Guesses are limited to 10 per address
# per 15 minutes, and each use is recorded in the audit log (the secret itself never is).
# Each client site has its own token (Settings -> Draft Verification Token), used as
# /api/preview?site=<site-slug>&secret=<token>. It opens that site's drafts only, never another site's and never the
# root site's, and it is checked, limited and audited the same way. Clear or change it to end the passes it issued.
# PREVIEW_SECRET_TOKEN=

# Scheduler / health probe. Send as Authorization: Bearer or x-cron-secret.
# CRON_SECRET=

# Signs one-click SRE approval links. Required before those links work.
# SRE_APPROVAL_SECRET=

# Webhook Notifications (Optional: Slack / Teams / Discord for CMS review alerts)
# NOTIFICATION_WEBHOOK_URL=https://hooks.slack.com/services/...

# Verifies legacy SHA-256 passwords already stored in a local studio.db.
# New passwords use per-user scrypt and do not need this.
# If you are upgrading a database created before this change, set this to the
# salt those hashes were created with, sign in once, and the hash is upgraded.
# AUTH_SALT=

# Optional first-boot demo accounts. Leave unset in production.
# The password must be at least 12 characters and cannot be one published in this repository, in any capitalisation;
# the same rule applies to every password anyone chooses (invitations, accounts an administrator creates).
# SEED_DEMO_USERS=true
# SEED_DEMO_PASSWORD=
# SEED_ADMIN_EMAIL=admin@bastion.local

# First platform administrator. There is no built-in admin account. When the
# database has no platform admin that can sign in, these two settings create one
# at startup (or restore the same account after its password was revoked).
# The password must be at least 12 characters and cannot be a published demo
# value. Once an admin can sign in these are ignored; remove them afterwards.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# Allows the SRE console to write a patch into src/ or public/ on this machine.
# Leave unset in production.
# SRE_LOCAL_PATCH=true
